async function start(){const {data:{session}}=await db.auth.getSession();if(session)enter(session);db.auth.onAuthStateChange((_e,s)=>s?enter(s):exit())}
function enter(s){$('login').classList.add('hidden');$('app').classList.remove('hidden');$('userEmail').textContent=s.user.email||'';loadData()}
