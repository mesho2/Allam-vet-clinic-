<section id="login" class="login"><form id="loginForm"><div class="mark">✚</div><h1>عيادة علام البيطرية</h1><p class="sub">سجّل الدخول لفتح ملفات العيادة</p><div class="field"><label>البريد الإلكتروني</label><input id="email" type="email" required autocomplete="username"></div><div class="field"><label>كلمة المرور</label><input id="password" type="password" required autocomplete="current-password"></div><div id="loginError" class="error"></div><button id="loginBtn" class="btn">تسجيل الدخول</button></form></section>
