$('loginForm').onsubmit=async e=>{e.preventDefault();$('loginError').textContent='';$('loginBtn').disabled=true;const {error}=await db.auth.signInWithPassword({email:$('email').value.trim(),password:$('password').value});$('loginBtn').disabled=false;if(error)$('loginError').textContent=fail(error)};$('logout').onclick=()=>db.auth.signOut();
async function read(table){const r=await db.from(table).select('*').limit(2000);if(r.error)throw r.error;return r.data||[]}
async function loadData(){ $('main').innerHTML='<div class="empty">جارٍ تحميل ملفات العيادة…</div>';try{[owners,patients,visits,vaccinations,payments]=await Promise.all([read('owners'),read('patients'),read('visits'),read('vaccinations'),read('payments')]);if(currentPatient){const id=currentPatient;currentPatient=null;openFile(id)}else home()}catch(e){$('main').innerHTML=`<div class="notice">تعذر تحميل البيانات: ${esc(fail(e))}<br>قد يكون هناك عمود مطلوب غير موجود في قاعدة البيانات. راجع ملف <b>supabase-setup.sql</b> المحدّث أو أرسل نص الخطأ.</div><button class="btn" onclick="loadData()">إعادة المحاولة</button>`}}
function ownerOf(p){return owners.find(o=>String(o.id)===String(p.owner_id))||{}}
function date(v){if(!v)return '—';try{return new Date(v+'T00:00:00').toLocaleDateString('ar-EG')}catch{return v}}
function animalText(p){const o=ownerOf(p);return [p.name,p.species,p.breed,p.sex,p.notes,o.name,o.phone,...visits.filter(x=>x.patient_id===p.id).flatMap(x=>[x.diagnosis,x.treatment,x.notes]),...vaccinations.filter(x=>x.patient_id===p.id).flatMap(x=>[x.vaccine_name,x.notes]),...payments.filter(x=>visits.some(v=>v.id===x.visit_id&&v.patient_id===p.id)).flatMap(x=>[x.amount,x.payment_method,x.notes])].join(' ').toLowerCase()}
function home(){currentPatient=null;const q=activeSearch.trim().toLowerCase(),shown=patients.filter(p=>!q||animalText(p).includes(q));const due=vaccinations.filter(v=>v.next_due_date&&new Date(v.next_due_date+'T23:59:59')<=new Date()).length;const today=new Date().toISOString().slice(0,10);const follow=visits.filter(v=>v.follow_up_date&&v.follow_up_date>=today).length;
$('main').innerHTML=`<div class="head"><div><h1>ملفات الحيوانات</h1><p>كل ملف يجمع بيانات الحيوان والمالك والتاريخ الطبي والحساب</p></div><button id="newAnimal" class="btn">＋ فتح ملف حيوان</button></div><div class="stats"><div class="stat"><span>الحيوانات المسجلة</span><strong>${patients.length}</strong></div><div class="stat"><span>إجمالي الزيارات</span><strong>${visits.length}</strong></div><div class="stat"><span>تطعيمات موعدها حان</span><strong>${due}</strong></div><div class="stat"><span>مواعيد متابعة قادمة</span><strong>${follow}</strong></div></div><div class="searchbar"><input id="globalSearch" class="search" type="search" placeholder="ابحث في كل شيء: اسم الحيوان، المالك، الهاتف، التشخيص، العلاج، التطعيم…" value="${esc(activeSearch)}"></div><div class="mobilehint">اكتب أي معلومة في خانة البحث، وافتح ملف الحيوان لمراجعة كل سجلاته.</div><div id="animalList" class="animals">${shown.length?shown.map(p=>card(p)).join(''):`<div class="empty" style="grid-column:1/-1">${q?'ملقيناش نتائج مطابقة. جرّب كلمة تانية.':'لسه مفيش ملفات حيوانات. ابدأ بفتح أول ملف.'}</div>`}</div>`;
$('newAnimal').onclick=()=>animalForm();$('globalSearch').oninput=e=>{activeSearch=e.target.value;const list=patients.filter(p=>!activeSearch.trim()||animalText(p).includes(activeSearch.trim().toLowerCase()));$('animalList').innerHTML=list.length?list.map(card).join(''):`<div class="empty" style="grid-column:1/-1">ملقيناش نتائج مطابقة.</div>`;bindCards()};bindCards()}
function card(p){const o=ownerOf(p),vcount=visits.filter(v=>v.patient_id===p.id).length,next=vaccinations.filter(v=>v.patient_id===p.id&&v.next_due_date).sort((a,b)=>a.next_due_date.localeCompare(b.next_due_date))[0];return `<article class="animal" data-id="${esc(p.id)}"><div class="animaltop"><div><h3>${esc(p.name)}</h3><p>${esc([p.species,p.breed].filter(Boolean).join(' · ')||'حيوان أليف')}</p><p>👤 ${esc(o.name||'—')}　☎ ${esc(o.phone||'—')}</p></div><div class="paw">🐾</div></div><span class="tag">${vcount} زيارة</span>${next?` <span class="tag">متابعة تطعيم: ${date(next.next_due_date)}</span>`:''}</article>`}
function bindCards(){$$(' .animal[data-id]'.trim()).forEach(el=>el.onclick=()=>openFile(el.dataset.id))}function $$(s){return document.querySelectorAll(s)}
function openFile(id){const p=patients.find(x=>String(x.id)===String(id));if(!p)return home();currentPatient=id;const o=ownerOf(p),pv=visits.filter(v=>String(v.patient_id)===String(id)).sort((a,b)=>(b.visit_date||'').localeCompare(a.visit_date||'')),vac=vaccinations.filter(v=>String(v.patient_id)===String(id)).sort((a,b)=>(a.next_due_date||a.vaccination_date||'').localeCompare(b.next_due_date||b.vaccination_date||'')),visitIds=pv.map(v=>String(v.id)),pay=payments.filter(x=>visitIds.includes(String(x.visit_id))).sort((a,b)=>(b.payment_date||'').localeCompare(a.payment_date||'')),paid=pay.reduce((n,x)=>n+Number(x.amount||0),0);
$('main').innerHTML=`<button class="back" id="back">→ كل ملفات الحيوانات</button><div class="profile"><div class="paw">🐾</div><div><h1>${esc(p.name)}</h1><p>${esc([p.species,p.breed,p.sex].filter(Boolean).join(' · ')||'بيانات الحيوان')}</p><p>👤 ${esc(o.name||'—')}　☎ ${esc(o.phone||'—')}　${o.address?`⌖ ${esc(o.address)}`:''}</p></div><div class="spacer"></div><button id="editAnimal" class="btn secondary editprofile">تعديل الملف</button></div><div class="sections"><section class="section"><div class="secthead"><h2>🩺 سجل الزيارات والتشخيص والعلاج</h2><button class="btn" id="addVisit">＋ زيارة</button></div><div class="sectbody">${pv.length?pv.map(v=>`<div class="record"><div><b>${date(v.visit_date)} ${v.diagnosis?' · '+esc(v.diagnosis):''}</b><small>${v.treatment?`💊 ${esc(v.treatment)}<br>`:''}${v.follow_up_date?`🔔 متابعة: ${date(v.follow_up_date)}<br>`:''}${v.notes?esc(v.notes):''}</small></div><button class="tiny" data-del="visits" data-id="${esc(v.id)}">حذف</button></div>`).join(''):'<div class="empty">لا توجد زيارات مسجلة</div>'}</div></section><section class="section"><div class="secthead"><h2>💉 التطعيمات ومواعيدها</h2><button class="btn" id="addVaccine">＋ تطعيم</button></div><div class="sectbody">${vac.length?vac.map(v=>`<div class="record"><div><b>${esc(v.vaccine_name||'تطعيم')}</b><small>أُعطي: ${date(v.vaccination_date)}<br>${v.next_due_date?`🔔 الجرعة/المتابعة القادمة: ${date(v.next_due_date)}`:''}${v.notes?`<br>${esc(v.notes)}`:''}</small></div><button class="tiny" data-del="vaccinations" data-id="${esc(v.id)}">حذف</button></div>`).join(''):'<div class="empty">لا توجد تطعيمات مسجلة</div>'}</div></section><section class="section"><div class="secthead"><h2>💰 الحساب والمدفوعات</h2><button class="btn" id="addPayment">＋ دفعة</button></div><div class="sectbody"><div class="record"><div><b>إجمالي المدفوعات المسجلة</b><small>إجمالي الحساب المسجل لهذا الحيوان</small></div><span class="money">${paid.toLocaleString('ar-EG')} ج.م</span></div>${pay.length?pay.map(x=>`<div class="record"><div><b>${Number(x.amount||0).toLocaleString('ar-EG')} ج.م</b><small>${date(x.payment_date)}${x.payment_method?' · '+esc(x.payment_method):''}${x.notes?' · '+esc(x.notes):''}</small></div><button class="tiny" data-del="payments" data-id="${esc(x.id)}">حذف</button></div>`).join(''):'<div class="empty">لا توجد مدفوعات مسجلة</div>'}</div></section><section class="section"><div class="secthead"><h2>📋 بيانات الملف</h2></div><div class="sectbody"><div class="record"><div><b>المالك</b><small>${esc(o.name||'—')} · ${esc(o.phone||'بدون هاتف')}</small></div></div><div class="record"><div><b>تاريخ الميلاد / العمر</b><small>${date(p.birth_date)}</small></div></div><div class="record"><div><b>الوزن</b><small>${p.weight?esc(p.weight)+' كجم':'غير مسجل'}</small></div></div><div class="record"><div><b>ملاحظات</b><small>${esc(p.notes||'لا توجد')}</small></div></div></div></section></div>`;
 $('back').onclick=()=>{currentPatient=null;home()};$('editAnimal').onclick=()=>animalForm(p,o);$('addVisit').onclick=()=>recordForm('visits',p);$('addVaccine').onclick=()=>recordForm('vaccinations',p);$('addPayment').onclick=()=>recordForm('payments',p,pv);$$('[data-del]').forEach(b=>b.onclick=()=>deleteRecord(b.dataset.del,b.dataset.id))}
function modal(title,fields,onSave){$('modal').innerHTML=`<div class="modback" id="shade"><form id="form" class="modal"><div class="modhead"><h2>${title}</h2><button type="button" class="close" id="x">✕</button></div><div class="grid">${fields}</div><div id="formError" class="error"></div><div class="actions"><button class="btn" id="save">حفظ</button><button type="button" class="btn secondary" id="cancel">إلغاء</button></div></form></div>`;$('x').onclick=$('cancel').onclick=()=>$('modal').innerHTML='';$('shade').onclick=e=>{if(e.target.id==='shade')$('modal').innerHTML=''};$('form').onsubmit=async e=>{e.preventDefault();$('save').disabled=true;const d=Object.fromEntries(new FormData(e.currentTarget).entries());for(const k in d)if(d[k]==='')d[k]=null;try{await onSave(d);$('modal').innerHTML='';toast('اتحفظت البيانات');await loadData()}catch(err){$('formError').textContent=fail(err);$('save').disabled=false}}}
function input(name,label,type='text',value='',required=false,wide=false){return `<div class="field ${wide?'wide':''}"><label>${label}${required?' *':''}</label>${type==='textarea'?`<textarea name="${name}" rows="3">${esc(value)}</textarea>`:`<input name="${name}" type="${type}" value="${esc(value)}" ${required?'required':''} ${type==='number'?'step="any" min="0"':''}>`}</div>`}
function animalForm(p=null,o={}){modal(p?'تعديل ملف الحيوان':'فتح ملف حيوان جديد',input('name','اسم الحيوان','text',p?.name||'',true)+input('species','النوع','text',p?.species||'',true)+input('breed','السلالة','text',p?.breed||'')+`<div class="field"><label>الجنس</label><select name="sex"><option value="">غير محدد</option><option ${p?.sex==='ذكر'?'selected':''}>ذكر</option><option ${p?.sex==='أنثى'?'selected':''}>أنثى</option></select></div>`+input('birth_date','تاريخ الميلاد','date',p?.birth_date||'')+input('weight','الوزن بالكيلو','number',p?.weight||'')+input('owner_name','اسم المالك','text',o.name||'',true)+input('owner_phone','رقم تليفون المالك','tel',o.phone||'',true)+input('address','العنوان','text',o.address||'')+input('notes','ملاحظات صحية','textarea',p?.notes||'',false,true),async d=>{let ownerId=p?.owner_id;if(ownerId){const {error}=await db.from('owners').update({name:d.owner_name,phone:d.owner_phone,address:d.address}).eq('id',ownerId);if(error)throw error}else{const {data,error}=await db.from('owners').insert({name:d.owner_name,phone:d.owner_phone,address:d.address}).select('id').single();if(error)throw error;ownerId=data.id}const payload={name:d.name,species:d.species,breed:d.breed,sex:d.sex,birth_date:d.birth_date,weight:d.weight?Number(d.weight):null,notes:d.notes,owner_id:ownerId};if(p){const res=await db.from('patients').update(payload).eq('id',p.id);if(res.error)throw res.error;currentPatient=p.id}else{const {data,error}=await db.from('patients').insert(payload).select('id').single();if(error)throw error;currentPatient=data.id}})}
function recordForm(type,p,pv=[]){const defs={visits:['إضافة زيارة',input('visit_date','تاريخ الزيارة','date',new Date().toISOString().slice(0,10),true)+input('diagnosis','التشخيص والحالة','text','')+input('treatment','العلاج والأدوية','textarea','',false,true)+input('follow_up_date','موعد المتابعة','date','')+input('notes','ملاحظات','textarea','',false,true),'visits'],vaccinations:['إضافة تطعيم',input('vaccine_name','اسم التطعيم','text','',true)+input('vaccination_date','تاريخ التطعيم','date',new Date().toISOString().slice(0,10),true)+input('next_due_date','موعد الجرعة القادمة / المتابعة','date','')+input('notes','ملاحظات','textarea','',false,true),'vaccinations'],payments:['إضافة دفعة',`<div class="field"><label>الزيارة المرتبطة</label><select name="visit_id"><option value="">بدون ربط بزيارة</option>${pv.map(v=>`<option value="${esc(v.id)}">${date(v.visit_date)} · ${esc(v.diagnosis||'زيارة')}</option>`).join('')}</select></div>`+input('amount','المبلغ بالجنيه','number','',true)+input('payment_date','تاريخ الدفع','date',new Date().toISOString().slice(0,10),true)+`<div class="field"><label>طريقة الدفع</label><select name="payment_method"><option value="نقدي">نقدي</option><option value="بطاقة">بطاقة</option><option value="تحويل">تحويل</option></select></div>`+input('notes','ملاحظات','text',''),'payments']};const [title,fields,table]=defs[type];modal(title,fields,async d=>{if(type!=='payments')d.patient_id=p.id;if(d.amount)d.amount=Number(d.amount);const {error}=await db.from(table).insert(d);if(error)throw error;currentPatient=p.id})}
async function deleteRecord(table,id){if(!confirm('متأكد إنك عايز تحذف السجل؟'))return;const {error}=await db.from(table).delete().eq('id',id);if(error){toast('تعذر الحذف: '+fail(error));return}toast('اتحذف السجل');loadData()}
start();
</script></body></html>
